{
  "name": "aidash-ui",
  "version": "0.2.0",
  "description": "Ink/TypeScript frontend for aidash",
  "type": "module",
  "bin": {
    "aidash-ui": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "cli-spinners": "^2.9.2",
    "ink": "^7.0.5",
    "ink-chart": "^0.1.1",
    "ink-scroll-view": "^0.3.7",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.1.0",
    "minimist": "^1.2.8",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "happy-dom": "^20.10.2",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
