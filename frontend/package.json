{
  "name": "aidash",
  "version": "0.2.0",
  "description": "Ink/TypeScript frontend for aidash",
  "type": "module",
  "bin": {
    "aidash-ui": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
